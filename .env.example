# ──────────────────────────────────────────────────────────────
# ClaimWise — Environment Variables
# Copy this file to .env.local and fill in values as needed.
# NEVER commit .env.local to Git. Server-side secrets must never
# be prefixed with NEXT_PUBLIC_.
# ──────────────────────────────────────────────────────────────

# ── Supabase (required — auth, database and private storage) ──
# Both values are safe to be public: the URL + publishable key
# model replaces the legacy anon key. Row Level Security is the
# real enforcement layer. Do NOT add a service-role key here or
# to any NEXT_PUBLIC_ variable — it bypasses RLS entirely.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Supabase Auth settings (configure in the dashboard, not here) ──
# Authentication → URL Configuration:
#   Site URL: your app URL
#   Redirect URLs: <app>/auth/callback
# Email confirmation: keep ON for production.
# Google OAuth: enable under Authentication → Providers → Google.
# No Google OAuth secret belongs in this file for that flow.

# ── Optional legacy integrations ──
# Used only by the legacy document-intelligence module, not the vault.
# GOOGLE_GEMINI_API_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Public app metadata (safe to expose) ──
NEXT_PUBLIC_APP_NAME=ClaimWise
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Optional E2E audit account ──
# Only used by e2e-audit.mjs. Create a reusable confirmed account
# through normal signup; the app never creates demo accounts.
# E2E_TEST_EMAIL=
# E2E_TEST_PASSWORD=
# E2E_BASE_URL=http://localhost:3000
